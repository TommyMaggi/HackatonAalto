{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DriftEvents",
  "description": "S6 output. Deviation attributed to specific signals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "created_at",
    "baseline_ref",
    "events"
  ],
  "properties": {
    "batch_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "baseline_ref": {
      "type": "string",
      "description": "Which normal-operation baseline this was scored against."
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "t_start",
          "kind",
          "severity",
          "ranked_signals",
          "evidence_ids"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "t_start": {
            "type": "integer"
          },
          "t_end": {
            "type": "integer"
          },
          "kind": {
            "enum": [
              "abrupt",
              "gradual"
            ]
          },
          "severity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "statistic": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "threshold": {
                "type": "number"
              },
              "threshold_source": {
                "type": "string"
              }
            }
          },
          "ranked_signals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "col_id",
                "contribution",
                "rank"
              ],
              "properties": {
                "col_id": {
                  "type": "string",
                  "pattern": "^col_[0-9]{3}$"
                },
                "contribution": {
                  "type": "number",
                  "description": "Share of the deviation. Must sum to about 1."
                },
                "rank": {
                  "type": "integer",
                  "minimum": 1
                },
                "direction": {
                  "enum": [
                    "above",
                    "below",
                    "unstable"
                  ]
                },
                "plain_language": {
                  "type": "string"
                }
              }
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ev_[0-9]{4,}$"
            },
            "description": "Evidence ids backing this claim. Empty is only valid when epistemic_status is 'assumed'."
          },
          "suppressed_by_dq": {
            "type": "boolean",
            "description": "True when S5 called the batch untrusted. The event is recorded but not diagnosed."
          }
        }
      }
    }
  }
}
